<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission needed to vibrate if the user has key press vibration enabled -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- DRS v1.23.0: built-in voice dictation — the platform recognizer
         requires the microphone permission. Requested lazily through the
         translucent VoicePermissionActivity trampoline on the first mic
         press; password/incognito contexts never reach the recognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- Permission needed to create notifications on devices running Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- DRS Update Center / Package Center: HTTPS-only access to the official
         GitHub Releases API and asset downloads. No other network traffic is
         ever initiated by the app. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DRS Update Center: required to hand a SHA-256-verified official APK to
         the platform package installer via the standard Android install flow. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- Android 11+ only: Define that DRS Keyboard requests to see all apps that
          ship with an IME or Spell Check service. This is used to guide the user
          in the Settings Ui why DRS Keyboard may not be working.
     -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod"/>
        </intent>
        <intent>
            <action android:name="android.service.textservice.SpellCheckerService"/>
        </intent>
    </queries>

    <application
        android:name="com.drs.smartkeyboard.DrsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/drs_app_icon"
        android:label="@string/drs_app_name"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/drs_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/DrsAppTheme"
        tools:targetApi="tiramisu">

        <!-- DRS p8 (C-3) / security-port (p8-E1-03): <profileable android:shell="true"/>
             was removed — it allowed any shell-uid context (adb / wireless debugging) to
             profile the production IME process (perfetto / simpleperf). Re-add per-variant
             for benchmarking builds only; release builds must not grant shell profiling. -->

        <!-- IME service -->
        <service
            android:name="com.drs.smartkeyboard.DrsImeService"
            android:label="@string/drs_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>

        <!-- Spellchecker service -->
        <service
            android:name="com.drs.smartkeyboard.DrsSpellCheckerService"
            android:label="@string/drs_app_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService"/>
            </intent-filter>
            <meta-data android:name="android.view.textservice.scs" android:resource="@xml/spellchecker"/>
        </service>

        <!-- Main App Activity -->
        <activity
            android:name="com.drs.smartkeyboard.app.DrsAppActivity"
            android:icon="@mipmap/drs_app_icon"
            android:label="@string/settings__title"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/drs_app_icon_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/DrsAppTheme.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ui" android:host="drs-keyboard" android:pathPrefix="/" />
            </intent-filter>
            <intent-filter android:label="Import Extension">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content"/>
                <data android:mimeType="application/vnd.drskeyboard.extension+zip"/>
                <data android:mimeType="application/octet-stream"/><!-- Firefox looking at you :eyes: -->
            </intent-filter>
            <intent-filter android:label="Import Extension">
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.drskeyboard.extension+zip"/>
                <data android:mimeType="application/octet-stream"/><!-- Firefox looking at you :eyes: -->
            </intent-filter>
        </activity>

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="com.drs.smartkeyboard.SettingsLauncherAlias"
            android:icon="@mipmap/drs_app_icon"
            android:label="@string/drs_app_name"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/drs_app_icon_round"
            android:targetActivity="com.drs.smartkeyboard.app.DrsAppActivity"
            android:theme="@style/DrsAppTheme.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- DRS Onboarding Activity (first-run adaptive setup) -->
        <activity
            android:name="com.drs.smartkeyboard.drs.ui.DrsOnboardingActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/DrsAppTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"/>

        <!-- Crash Dialog Activity -->
        <activity
            android:name="com.drs.smartkeyboard.lib.crashutility.CrashDialogActivity"
            android:icon="@mipmap/drs_app_icon"
            android:label="@string/crash_dialog__title"
            android:configChanges="orientation|screenSize"
            android:theme="@style/CrashDialogTheme"/>

        <!-- Copy to Clipboard Activity -->
        <activity
            android:name="com.drs.smartkeyboard.ime.clipboard.DrsCopyToClipboardActivity"
            android:theme="@style/DrsAppTheme.Transparent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- DRS v1.11.0: Popup Clipboard Editor Window — a dialog-styled
             translucent activity that floats above the whole screen (the
             app behind stays visible through the scrim). Serves the smart
             clipboard text editor outside the keyboard panel, as requested. -->
        <activity
            android:name="com.drs.smartkeyboard.ime.clipboard.ClipEditorPopupActivity"
            android:theme="@style/DrsAppTheme.ClipEditorPopup"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"/>

        <!-- DRS v1.23.0: the microphone permission trampoline — a
             translucent activity the IME service launches on the first
             mic press (an IME cannot host permission dialogs itself).
             Grants/denies hand back through DrsVoiceInputBus, then the
             activity finishes immediately. -->
        <activity
            android:name="com.drs.smartkeyboard.ime.voice.VoicePermissionActivity"
            android:theme="@style/DrsAppTheme.Transparent"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"/>

        <!-- Clipboard Media File Provider -->
        <provider
            android:name="com.drs.smartkeyboard.ime.clipboard.provider.ClipboardMediaProvider"
            android:authorities="${applicationId}.provider.clipboard"
            android:grantUriPermissions="true"
            android:exported="false">
        </provider>

        <!-- Default file provider to share files from the "files" or "cache" dir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider.file"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Disable default EmojiCompat initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove"/>
        </provider>

    </application>

</manifest>
