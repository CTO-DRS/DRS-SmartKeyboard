{
  "$schema": "https://schemas.drs-keyboard.org/v1/theme",
  "@defines": {
    "--primary": "#2DD4BF",
    "--primary-variant": "#14B8A6",
    "--background": "#F0FDFA",
    "--surface": "#CCFBF1",
    "--on-primary": "#042F2E",
    "--on-background": "#134E4A"
  },
  "keyboard": {
    "background": "{surface}"
  },
  "key": {
    "background": "{primary}",
    "foreground": "{on-primary}"
  }
}
