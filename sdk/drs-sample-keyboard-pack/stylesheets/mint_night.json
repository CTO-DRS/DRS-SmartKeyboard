{
  "$schema": "https://schemas.drs-keyboard.org/v1/theme",
  "@defines": {
    "--primary": "#14B8A6",
    "--primary-variant": "#0D9488",
    "--background": "#04211E",
    "--surface": "#0A322E",
    "--on-primary": "#04211E",
    "--on-background": "#CCFBF1"
  },
  "keyboard": {
    "background": "{surface}"
  },
  "key": {
    "background": "{primary}",
    "foreground": "{on-primary}"
  }
}
